// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector, pg_graphql, pg_stat_statements, pgcrypto, supabase_vault, uuid_ossp(map: "uuid-ossp")]
}

model Scheme {
  id             Int                          @id @default(autoincrement())
  scheme_name    String
  details        String?                      @db.Text
  benefits       String?                      @db.Text
  eligibility    String?                      @db.Text
  application    String?                      @db.Text
  documents      String?                      @db.Text
  level          String?
  schemeCategory String?
  tags           String?
  full_text      String?                      @db.Text
  embedding      Unsupported("vector(3072)")?

  @@map("schemes")
}



enum Gender {
  Male
  Female
  Other
}

enum CasteCategory {
  General
  OBC
  SC
  ST
  EWS
}

enum Occupation {
  Student
  Farmer
  Teacher
  Researcher
  Business
  SmallBusiness
  DairyFarm
  JobSeeker
  SelfEmployed
  Other
}

enum RationCard {
  APL
  BPL
  AAY
  None
}

enum InstitutionType {
  Government
  Private
  CentralUniversity
  StateUniversity
  Other
}

enum EducationLevel {
  Below10th
  Class10th
  Class12th
  ITI
  Diploma
  Graduate
  Postgraduate
  PhD
  Other
}

model UserProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Link to your auth user (Supabase)
  userId String @unique

  // ── Universal ─────────────────────────────────────────────
  name           String
  age            Int
  gender         Gender
  state          String
  district       String
  caste          CasteCategory
  annualIncome   Int // in rupees
  disability     Boolean       @default(false)
  disabilityType String? // if disability = true
  rationCard     RationCard    @default(None)
  religion       String?

  // ── Occupation ────────────────────────────────────────────
  occupation Occupation

  // ── Student / Teacher / Researcher ───────────────────────
  educationLevel  EducationLevel?
  institutionType InstitutionType?
  courseName      String? // e.g. B.Tech CSE, M.Sc Physics
  yearOfStudy     Int?
  marksPercentage Float?
  experienceYears Int? // for Teacher/Researcher

  // ── Farmer / Dairy ────────────────────────────────────────
  landSizeAcres    Float?
  landOwnership    Boolean? // true = owns land
  cropType         String? // wheat, rice, cotton etc
  irrigationAccess Boolean?
  animalCount      Int?
  animalType       String? // cow, buffalo, goat etc

  // ── Business / MSME ──────────────────────────────────────
  businessType   String? // manufacturing, service, retail
  gstRegistered  Boolean?
  msmeRegistered Boolean?
  udyamNumber    String?
  employeeCount  Int?
  annualTurnover Int?
}

// ── Chat Storage ──────────────────────────────────────────
model ChatSession {
  id        String   @id @default(cuid())
  userId    String   // Supabase auth.users UUID
  title     String   @default("New Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  ChatMessage[]

  // Short-term memory fields
  buffer   Json   @default("[]")  // last 3 Q&A pairs as JSON array
  summary  String @default("")    // compressed older history (3 sentences)
  msgCount Int    @default(0)     @map("msg_count") // triggers summary at every 5th message

  @@map("chat_sessions")
}

model ChatMessage {
  id           String      @id @default(cuid())
  sessionId    String
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role         String      // 'user' | 'assistant'
  content      String      @db.Text
  schemesFound Json?       // scheme cards from FastAPI response
  createdAt    DateTime    @default(now())

  @@map("chat_messages")
}

// ── Admin Panel ───────────────────────────────────────────
model AdminUser {
  id        String   @id @default(cuid())
  userId    String   @unique // Supabase auth.users UUID
  email     String   @unique
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}
